    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Register Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Register candidate - 201 Created (or 409 if candidate already exists)",
                  "pm.test('Status is 201 Created or 409 Conflict', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test('success flag is true', function () {",
                  "        pm.expect(pm.response.json().success).to.be.true;",
                  "    });",
                  "    pm.test('Token is present in response', function () {",
                  "        const res = pm.response.json();",
                  "        pm.expect(res.data).to.have.property('token');",
                  "        pm.expect(res.data.token).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('Password is NOT exposed in response body', function () {",
                  "        const raw = pm.response.text();",
                  "        pm.expect(raw).to.not.include('\"password\"');",
                  "    });",
                  "    pm.test('User object is present and has expected fields', function () {",
                  "        const res = pm.response.json();",
                  "        pm.expect(res.data.user).to.include.keys('_id', 'email', 'fullName', 'role');",
                  "    });",
                  "    const res = pm.response.json();",
                  "    if (res.success && res.data && res.data.token) {",
                  "        pm.collectionVariables.set('token', res.data.token);",
                  "        console.log('Saved new JWT token');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email for automated runner runs to avoid duplicate 409 conflict",
                  "const timestamp = Date.now();",
                  "const dynamicEmail = 'candidate_' + timestamp + '@example.com';",
                  "pm.collectionVariables.set('candidateEmail', dynamicEmail);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new candidate and returns candidate profile along with JWT token."
          },
          "response": []
        },
        {
          "name": "Login Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check 7: Login with correct credentials — 200, token in response",
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test('success flag is true', function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('Token is present in response', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data).to.have.property('token');",
                  "    pm.expect(res.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('accessToken is present in response', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data).to.have.property('accessToken');",
                  "    pm.expect(res.data.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Password is NOT exposed in response body', function () {",
                  "    const raw = pm.response.text();",
                  "    pm.expect(raw).to.not.include('\"password\"');",
                  "});",
                  "pm.test('User object has expected fields', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.user).to.include.keys('_id', 'email', 'fullName', 'role');",
                  "});",
                  "// Save token for subsequent requests",
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('JWT Token successfully updated in collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in an existing candidate and automatically saves the JWT token into {{token}} collection variable."
          },
          "response": []
        },
