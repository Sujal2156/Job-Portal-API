    {
      "name": "02. Jobs",
      "item": [
        {
          "name": "Get All Jobs (Auto-sets jobId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test('success flag is true', function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('Response contains a jobs array', function () {",
                  "    const res = pm.response.json();",
                  "    const jobs = Array.isArray(res.data) ? res.data : (res.data && res.data.jobs);",
                  "    pm.expect(jobs).to.be.an('array');",
                  "});",
                  "pm.test('Jobs list contains jobs', function () {",
                  "    const res = pm.response.json();",
                  "    const jobs = Array.isArray(res.data) ? res.data : (res.data && res.data.jobs || []);",
                  "    pm.expect(jobs.length).to.be.at.least(1);",
                  "});",
                  "pm.test('Each job has _id, title, and company', function () {",
                  "    const res = pm.response.json();",
                  "    const jobs = Array.isArray(res.data) ? res.data : (res.data && res.data.jobs || []);",
                  "    jobs.forEach(function (job) {",
                  "        pm.expect(job).to.include.keys('_id', 'title', 'company');",
                  "    });",
                  "});",
                  "// Save first jobId for subsequent requests",
                  "const res = pm.response.json();",
                  "const jobs = Array.isArray(res.data) ? res.data : (res.data && res.data.jobs || []);",
                  "if (res.success && jobs.length > 0) {",
                  "    pm.collectionVariables.set('jobId', jobs[0]._id);",
                  "    console.log('Saved jobId:', jobs[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs"
              ]
            },
            "description": "Fetches all active job openings and automatically stores the first job ID in {{jobId}} for easy testing."
          },
